#!/usr/bin/env python3
"""
Workspace Layouts Switcher
A formal, minimalist, monochrome interface for managing COSMIC desktop
window layouts and hardware display profiles.
"""

import sys
import os
import subprocess
import signal
import threading

# Ensure phoenix bin is in path for imports
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

import gi
gi.require_version('Gtk', '4.0')
try:
    gi.require_version('Adw', '1')
    from gi.repository import Adw
    HAS_ADW = True
except Exception:
    HAS_ADW = False

from gi.repository import Gtk, Gdk, GLib, Gio
import phoenix_profile

APP_ID = "com.system76.CosmicAppletWorkspaceLayouts"
PHOENIX_CLI = os.path.join(SCRIPT_DIR, "phoenix")


def esc(v):
    """Escape any dynamic value before it goes into Pango markup."""
    return GLib.markup_escape_text(str(v))


def run_phoenix_async(args, on_done):
    """Runs `phoenix <args>` off the GTK main loop; on_done(returncode) runs on the main loop."""
    def worker():
        try:
            rc = subprocess.run([sys.executable, PHOENIX_CLI] + args, check=False,
                                stdin=subprocess.DEVNULL).returncode
        except OSError:
            rc = 127
        GLib.idle_add(lambda: (on_done(rc), False)[1])
    threading.Thread(target=worker, daemon=True).start()

# Strictly monochrome, minimalist styling
CUSTOM_CSS = b"""
window.layout-popup {
    background-color: alpha(@window_bg_color, 0.98);
    border: 1px solid alpha(@borders, 0.4);
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
}
.layout-header {
    padding: 14px 16px;
    border-bottom: 1px solid alpha(@borders, 0.2);
}
.layout-card {
    background-color: alpha(@card_bg_color, 0.4);
    border: 1px solid alpha(@borders, 0.2);
    border-radius: 10px;
    padding: 10px 12px;
    margin: 2px 2px;
}
.profile-active {
    border: 1px solid alpha(@window_fg_color, 0.5);
    background-color: alpha(@window_fg_color, 0.08);
}
.badge-active {
    background-color: alpha(@window_fg_color, 0.9);
    color: @window_bg_color;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}
.badge-match {
    background-color: transparent;
    color: alpha(@window_fg_color, 0.8);
    border: 1px solid alpha(@window_fg_color, 0.3);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}
.hardware-info {
    font-size: 12px;
    color: alpha(@window_fg_color, 0.7);
}
.section-heading {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: alpha(@window_fg_color, 0.5);
    margin-top: 4px;
    margin-bottom: 2px;
}
"""

class WorkspaceLayoutsPopup:
    def __init__(self, app):
        self.app = app
        self.win = None
        self.status_label = None
        self.profiles_container = None
        self.hw_container = None
        self._busy = False

    def create_window(self):
        # Apply CSS
        provider = Gtk.CssProvider()
        provider.load_from_data(CUSTOM_CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        if HAS_ADW:
            self.win = Adw.ApplicationWindow(application=self.app)
        else:
            self.win = Gtk.ApplicationWindow(application=self.app)

        self.win.set_title("Workspace Layouts")
        self.win.set_default_size(440, 520)
        self.win.set_resizable(False)
        self.win.add_css_class("layout-popup")

        # Key controller to close on Escape
        key_ctrl = Gtk.EventControllerKey.new()
        key_ctrl.connect("key-pressed", self.on_key_pressed)
        self.win.add_controller(key_ctrl)

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        # Header
        header = self.build_header()
        main_box.append(header)

        # Scrolled contents
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        content_box.set_margin_top(12)
        content_box.set_margin_bottom(12)
        content_box.set_margin_start(14)
        content_box.set_margin_end(14)

        # Hardware detection info card
        self.hw_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        content_box.append(self.hw_container)

        # Profile list heading
        lbl = Gtk.Label(label="CONFIGURED PROFILES")
        lbl.set_halign(Gtk.Align.START)
        lbl.add_css_class("section-heading")
        content_box.append(lbl)

        # Profile list
        self.profiles_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        content_box.append(self.profiles_container)

        scrolled.set_child(content_box)
        main_box.append(scrolled)

        # Footer actions
        footer = self.build_footer()
        main_box.append(footer)

        if HAS_ADW:
            self.win.set_content(main_box)
        else:
            self.win.set_child(main_box)

        self.win.present()
        self.refresh_all()

    def refresh_all(self):
        """Probes hardware once in a worker thread, then rebuilds both cards on the main loop."""
        def worker():
            try:
                result = phoenix_profile.detect_profile()
            except Exception:
                result = (None, 0, [], {})
            GLib.idle_add(lambda: (self._apply_detection(result), False)[1])
        threading.Thread(target=worker, daemon=True).start()

    def _apply_detection(self, result):
        if self.win is None:
            return
        self.refresh_hardware_card(result)
        self.refresh_profiles_list(result)

    def set_busy(self, busy):
        self._busy = busy
        if self.win is not None:
            self.win.set_sensitive(not busy)

    def on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.win.close()
            return True
        return False

    def build_header(self):
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header_box.add_css_class("layout-header")

        # Formal Minimalist Icon
        icon_img = Gtk.Image.new_from_icon_name("workspace-layouts-symbolic")
        icon_img.set_pixel_size(32)
        header_box.append(icon_img)

        # Titles
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_box.set_hexpand(True)
        title_box.set_valign(Gtk.Align.CENTER)

        title_lbl = Gtk.Label()
        title_lbl.set_halign(Gtk.Align.START)
        title_lbl.set_markup("<b>Workspace Layouts</b>")

        cfg = phoenix_profile.load_profiles_config()
        state = phoenix_profile.get_profile_state()
        active_p = state.get("active_profile", cfg.get("default_profile", "home"))

        self.status_label = Gtk.Label()
        self.status_label.set_halign(Gtk.Align.START)
        self.status_label.set_markup(f"<small>Active: <b>{esc(active_p.capitalize())}</b></small>")
        self.status_label.add_css_class("hardware-info")

        title_box.append(title_lbl)
        title_box.append(self.status_label)
        header_box.append(title_box)

        # Close button
        close_btn = Gtk.Button.new_from_icon_name("window-close-symbolic")
        close_btn.set_valign(Gtk.Align.CENTER)
        close_btn.add_css_class("flat")
        close_btn.connect("clicked", lambda b: self.win.close())
        header_box.append(close_btn)

        return header_box

    def refresh_hardware_card(self, detection):
        # Clear
        child = self.hw_container.get_first_child()
        while child:
            next_child = child.get_next_sibling()
            self.hw_container.remove(child)
            child = next_child

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.add_css_class("layout-card")

        top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl = Gtk.Label()
        lbl.set_markup("<b>Hardware Environment</b>")
        lbl.set_hexpand(True)
        lbl.set_halign(Gtk.Align.START)
        top_row.append(lbl)

        # Auto-detect button (monochrome outline/flat)
        detect_btn = Gtk.Button(label="Auto-Detect")
        detect_btn.connect("clicked", self.on_auto_detect_clicked)
        top_row.append(detect_btn)
        card.append(top_row)

        # Detect
        detected_p, score, reasons, env = detection
        wifi_list = env.get("wifi", [])
        wifi = ", ".join(wifi_list) if wifi_list else "None / Wired"

        monitors = env.get("monitors", [])
        models = env.get("models", [])
        
        info_wifi = Gtk.Label()
        info_wifi.set_halign(Gtk.Align.START)
        info_wifi.set_text(f"Wi-Fi: {wifi}")
        info_wifi.add_css_class("hardware-info")
        card.append(info_wifi)

        mon_str = ", ".join(models) if models else (", ".join(monitors) if monitors else "Internal Display")
        info_mon = Gtk.Label()
        info_mon.set_halign(Gtk.Align.START)
        info_mon.set_wrap(True)
        info_mon.set_text(f"Displays ({len(monitors)}): {mon_str}")
        info_mon.add_css_class("hardware-info")
        card.append(info_mon)

        if detected_p and score > 0:
            match_lbl = Gtk.Label()
            match_lbl.set_halign(Gtk.Align.START)
            match_lbl.set_markup(f"<small>Matched: <b>{esc(detected_p.capitalize())}</b> ({esc(', '.join(reasons))})</small>")
            match_lbl.add_css_class("hardware-info")
            card.append(match_lbl)

        self.hw_container.append(card)

    def refresh_profiles_list(self, detection):
        # Clear existing
        child = self.profiles_container.get_first_child()
        while child:
            next_child = child.get_next_sibling()
            self.profiles_container.remove(child)
            child = next_child

        cfg = phoenix_profile.load_profiles_config()
        state = phoenix_profile.get_profile_state()
        active_name = state.get("active_profile", cfg.get("default_profile", "home"))
        detected_name, score, _, _ = detection

        for name, pdata in cfg.get("profiles", {}).items():
            row = self.build_profile_row(name, pdata, is_active=(name == active_name), is_best=(name == detected_name and score > 0))
            self.profiles_container.append(row)

        if self.status_label:
            self.status_label.set_markup(f"<small>Active: <b>{esc(active_name.capitalize())}</b></small>")

    def build_profile_row(self, name, pdata, is_active=False, is_best=False):
        row_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        row_box.add_css_class("layout-card")
        if is_active:
            row_box.add_css_class("profile-active")

        top_line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        
        # Formal monochrome icon for row
        p_icon = Gtk.Image.new_from_icon_name("video-display-symbolic")
        top_line.append(p_icon)

        # Name
        name_lbl = Gtk.Label()
        name_lbl.set_markup(f"<b>{esc(name.capitalize())}</b>")
        name_lbl.set_halign(Gtk.Align.START)
        top_line.append(name_lbl)

        if is_active:
            active_badge = Gtk.Label(label="Active")
            active_badge.add_css_class("badge-active")
            top_line.append(active_badge)

        if is_best and not is_active:
            match_badge = Gtk.Label(label="Matched")
            match_badge.add_css_class("badge-match")
            top_line.append(match_badge)

        # Spacer
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        top_line.append(spacer)

        # Switch & Restore Button (monochrome)
        if not is_active:
            switch_btn = Gtk.Button(label="Switch")
            switch_btn.connect("clicked", lambda b, p=name: self.on_switch_profile(p))
            top_line.append(switch_btn)
        else:
            save_btn = Gtk.Button(label="Save")
            save_btn.add_css_class("flat")
            save_btn.set_tooltip_text("Save current window positions to this profile")
            save_btn.connect("clicked", lambda b, p=name: self.on_save_profile(p))
            top_line.append(save_btn)

        row_box.append(top_line)

        # Details
        desc = pdata.get("description", "")
        wifis = ", ".join(pdata.get("wifi_ssids", []))
        monitors = ", ".join(pdata.get("monitors", []))
        
        detail_text = f"<small>{esc(desc)}</small>"
        if wifis or monitors:
            detail_text += f"\n<span alpha='60%' size='smaller'>Triggers: Wi-Fi: [{esc(wifis or 'any')}] | Displays: [{esc(monitors or 'any')}]</span>"
        
        desc_lbl = Gtk.Label()
        desc_lbl.set_markup(detail_text)
        desc_lbl.set_halign(Gtk.Align.START)
        desc_lbl.set_wrap(True)
        desc_lbl.add_css_class("hardware-info")
        row_box.append(desc_lbl)

        return row_box

    def build_footer(self):
        footer_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        footer_box.set_margin_start(14)
        footer_box.set_margin_end(14)
        footer_box.set_margin_top(6)
        footer_box.set_margin_bottom(12)

        # New Profile button
        new_btn = Gtk.Button(label="+ New Profile...")
        new_btn.add_css_class("flat")
        new_btn.connect("clicked", self.on_new_profile_dialog)
        footer_box.append(new_btn)

        # Spacer
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        footer_box.append(spacer)

        # Restore Windows button
        restore_btn = Gtk.Button(label="Restore Layout")
        restore_btn.set_tooltip_text("Restore window layout for the active profile")
        restore_btn.connect("clicked", self.on_restore_windows)
        footer_box.append(restore_btn)

        return footer_box

    def on_switch_profile(self, profile_name):
        if self._busy:
            return
        print(f"Switching to profile: {profile_name}")
        self.set_busy(True)

        def done(rc):
            self.set_busy(False)
            if rc == 0:
                self.show_notification(f"Switched to '{profile_name}' and restored window layout.")
            else:
                self.show_notification(f"Switching to '{profile_name}' failed (exit {rc}).")
            self.refresh_all()
        run_phoenix_async(["profile", "switch", "-r", "--", profile_name], done)

    def on_save_profile(self, profile_name):
        if self._busy:
            return
        self.set_busy(True)

        def done(rc):
            self.set_busy(False)
            self.show_notification(f"Saved window positions to '{profile_name}'." if rc == 0
                                   else f"Saving '{profile_name}' failed (exit {rc}).")
            self.refresh_all()
        run_phoenix_async(["profile", "save", "--", profile_name], done)

    def on_auto_detect_clicked(self, btn):
        def worker():
            try:
                result = phoenix_profile.detect_profile()
            except Exception:
                result = (None, 0, [], {})
            GLib.idle_add(lambda: (self._on_detected(result), False)[1])
        threading.Thread(target=worker, daemon=True).start()

    def _on_detected(self, result):
        detected_name, score, _, _ = result
        if detected_name and score > 0:
            self.on_switch_profile(detected_name)
        else:
            self.show_notification("No matching profile detected; using active profile.")
            self._apply_detection(result)

    def on_restore_windows(self, btn):
        if self._busy:
            return
        cfg = phoenix_profile.load_profiles_config()
        state = phoenix_profile.get_profile_state()
        active = state.get("active_profile", cfg.get("default_profile", "home"))
        self.set_busy(True)

        def done(rc):
            self.set_busy(False)
            self.show_notification(f"Restored window layout for '{active}'." if rc == 0
                                   else f"Restoring '{active}' failed (exit {rc}).")
        run_phoenix_async(["profile", "restore", "--", active], done)

    def on_new_profile_dialog(self, btn):
        dialog = Gtk.Window(title="Create Profile")
        dialog.set_transient_for(self.win)
        dialog.set_modal(True)
        dialog.set_default_size(300, 150)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_margin_start(16)
        box.set_margin_end(16)
        box.set_margin_top(16)
        box.set_margin_bottom(16)

        lbl = Gtk.Label(label="Profile Name:")
        lbl.set_halign(Gtk.Align.START)
        box.append(lbl)

        entry = Gtk.Entry()
        entry.set_placeholder_text("e.g. office, presentation")
        box.append(entry)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_row.set_halign(Gtk.Align.END)
        
        cancel_btn = Gtk.Button(label="Cancel")
        cancel_btn.connect("clicked", lambda b: dialog.close())
        btn_row.append(cancel_btn)

        save_btn = Gtk.Button(label="Create & Learn")
        
        def do_save(b):
            pname = entry.get_text().strip().lower()
            if not phoenix_profile.is_valid_profile_name(pname):
                entry.add_css_class("error")
                lbl.set_text("Use letters, digits, '-' or '_' (max 32):")
                return
            dialog.close()
            self.set_busy(True)

            def added(rc):
                if rc != 0:
                    self.set_busy(False)
                    self.show_notification(f"Creating profile '{pname}' failed (exit {rc}).")
                    return
                self.set_busy(False)
                self.on_switch_profile(pname)
            run_phoenix_async(["profile", "add", "--learn", "--", pname], added)

        save_btn.connect("clicked", do_save)
        btn_row.append(save_btn)
        box.append(btn_row)

        dialog.set_child(box)
        dialog.present()

    def show_notification(self, message):
        subprocess.Popen(["notify-send", "-a", "Workspace Layouts", "-i", "workspace-layouts-symbolic", "Workspace Layouts", message],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    # Gtk.Application with an application_id is already single-instance: a second
    # launch (e.g. the panel button clicked again) just re-activates this process,
    # which toggles the window. No PID file needed.
    if HAS_ADW:
        app = Adw.Application(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
    else:
        app = Gtk.Application(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

    popup = WorkspaceLayoutsPopup(app)

    def on_activate(a):
        if popup.win is not None and popup.win.get_visible():
            popup.win.close()
            popup.win = None
        else:
            popup.create_window()

    app.connect("activate", on_activate)
    for sig in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, lambda *a: (app.quit(), GLib.SOURCE_REMOVE)[1])

    # --toggle is accepted for backward compatibility; toggling is now the default.
    sys.exit(app.run(None))

if __name__ == "__main__":
    main()
