[Desktop Entry]
Name=Phoenix Profile Switcher
Comment=Switch COSMIC desktop layouts and profiles
Type=Application
Exec=cosmic-panel-button com.phoenix.CosmicAppletProfile
Terminal=false
Categories=COSMIC;Utility;
Icon=phoenix-profile-symbolic
StartupNotify=false
NoDisplay=true
X-CosmicApplet=true
X-HostWaylandDisplay=true
X-OverflowPriority=5
X-OverflowMinSize=8
